# Core API
HOST_ADDRESS=127.0.0.1
PORT=8765
HARNESS_DB=data/harness.db
PROJECT_ROOT=.
NEUROKERNEL_CORE_URL=http://127.0.0.1:8765

# Discord bot
DISCORD_BOT_TOKEN=put_discord_bot_token_here
DISCORD_CHANNEL_ID=put_discord_channel_id_here
DISCORD_ALLOWED_USER_IDS=put_user_id_here,put_another_user_id_here
DISCORD_ALLOW_DMS=false
NEUROKERNEL_BOT_PREFIX=
NEUROKERNEL_BOT_REPLY_WITHOUT_PREFIX=1
NEUROKERNEL_BOT_AUTO_DO_LOW_RISK=1
NEUROKERNEL_BOT_WORK_NOTIFY_ENABLED=1
NEUROKERNEL_BOT_WORK_NOTIFY_INTERVAL=10

# Runtime
LOG_DIR=logs
NEUROKERNEL_ACTION_REGISTRY=registry/actions.json

# Queue / worker
NEUROKERNEL_QUEUE_ENABLED=1
NEUROKERNEL_REDIS_URL=redis://127.0.0.1:6379/0
NEUROKERNEL_WORKER_ENABLED=1
NEUROKERNEL_WORKER_QUEUES=self_patch external_work
NEUROKERNEL_WORKER_BLOCK_MS=0
NEUROKERNEL_SELF_PATCH_RUN_ROOT=artifacts/self_patch
NEUROKERNEL_SELF_PATCH_TEST_COMMAND='python -m pytest -q'
NEUROKERNEL_SELF_PATCH_CODEX_TIMEOUT=420
NEUROKERNEL_SELF_PATCH_TEST_TIMEOUT=300
NEUROKERNEL_SELF_PATCH_CODEX_IDLE_TIMEOUT=120
NEUROKERNEL_SELF_PATCH_TEST_IDLE_TIMEOUT=90
NEUROKERNEL_SELF_PATCH_WATCHDOG_POLL=2.0
NEUROKERNEL_SELF_PATCH_WATCHDOG_FILE_SCAN=10.0
NEUROKERNEL_SELF_PATCH_SANDBOX=workspace-write
NEUROKERNEL_SELF_PATCH_ISOLATION=auto

# Activation pipeline
NEUROKERNEL_ACTIVATION_TEST_COMMAND='python -m pytest -q'
NEUROKERNEL_ACTIVATION_TEST_TIMEOUT=300
NEUROKERNEL_ACTIVATION_RELOAD_COMMAND='bash tools/restart_orangepi_stack_deferred.sh'
NEUROKERNEL_ACTIVATION_RELOAD_TIMEOUT=30
NEUROKERNEL_ACTIVATION_REQUIRE_CLEAN_GIT=1
NEUROKERNEL_ACTIVATION_COMMIT=1
NEUROKERNEL_ACTIVATION_ARCHIVE_ROOT=artifacts/activations
NEUROKERNEL_ACTIVATION_VERIFY=1
NEUROKERNEL_ACTIVATION_SMOKE_TIMEOUT=30

# Codex language organ / worker adapter
NEUROKERNEL_CODEX_BIN=codex
NEUROKERNEL_LANGUAGE_WORKSPACE=/home/ubuntu/projects/neurokernel-agi-seed/language_workspace
NEUROKERNEL_LANGUAGE_SCHEMA_DIR=/home/ubuntu/projects/neurokernel-agi-seed/schemas
NEUROKERNEL_LANGUAGE_TIMEOUT=45
