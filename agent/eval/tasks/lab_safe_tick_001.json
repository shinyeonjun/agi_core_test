{
  "id": "lab_safe_tick_001",
  "suite": "lab",
  "description": "Safe profile lab tick may propose but must not execute",
  "steps": [
    {
      "cmd": "agentctl autonomy set safe",
      "expect": {
        "autonomy_profile": "safe"
      }
    },
    {
      "cmd": "agentctl lab tick",
      "expect": {
        "executed": false,
        "status": "skipped",
        "reason": "profile_not_full_device_lab"
      }
    }
  ],
  "expect": {
    "executed": false,
    "status": "skipped",
    "reason": "profile_not_full_device_lab"
  }
}
