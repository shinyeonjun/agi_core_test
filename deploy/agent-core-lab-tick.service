[Unit]
Description=Local Stateful Agent Core Lab Tick
Wants=network-online.target
After=network-online.target agent-core-discord.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/agent_core
EnvironmentFile=-/home/ubuntu/agent_core/.env
ExecStart=/home/ubuntu/agent_core/venv/bin/agentctl lab tick-if-enabled --notify
NoNewPrivileges=true
