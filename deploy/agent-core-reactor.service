[Unit]
Description=Local Stateful Agent Core Event Reactor
After=network-online.target agent-core-discord.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/agent_core
EnvironmentFile=-/home/ubuntu/agent_core/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/agent_core/venv/bin/python -m agent.cli.agentctl reactor run
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
