{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroKernel WorkRouteDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "reason",
    "confidence",
    "work_item",
    "requires_confirmation",
    "clarifying_question",
    "safety_notes"
  ],
  "properties": {
    "route": {
      "type": "string",
      "enum": ["runtime_task", "work_status", "self_patch", "external_work", "unsafe", "clarify"]
    },
    "reason": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "work_item": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "goal", "priority", "risk_level", "deliverables", "open_questions"],
          "properties": {
            "type": { "type": "string", "enum": ["runtime_task", "self_patch", "external_work"] },
            "title": { "type": "string" },
            "goal": { "type": "string" },
            "priority": { "type": "string", "enum": ["low", "medium", "high"] },
            "risk_level": { "type": "string", "enum": ["none", "low", "medium", "high", "forbidden"] },
            "deliverables": { "type": "array", "items": { "type": "string" } },
            "open_questions": { "type": "array", "items": { "type": "string" } }
          }
        },
        { "type": "null" }
      ]
    },
    "requires_confirmation": { "type": "boolean" },
    "clarifying_question": { "type": ["string", "null"] },
    "safety_notes": { "type": "array", "items": { "type": "string" } }
  }
}
