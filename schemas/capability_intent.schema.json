{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroKernel CapabilityIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "reply",
    "gap",
    "proposal",
    "confidence",
    "requires_confirmation",
    "clarifying_question",
    "safety_notes"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["none", "gap", "ambiguous", "forbidden"]
    },
    "reply": { "type": "string" },
    "gap": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gap_type",
            "requested_capability",
            "normalized_request",
            "matched_existing_actions",
            "confidence"
          ],
          "properties": {
            "gap_type": {
              "type": "string",
              "enum": [
                "missing_action",
                "missing_parameter",
                "missing_target",
                "missing_permission",
                "missing_executor",
                "composite_skill_gap",
                "ambiguous_request",
                "forbidden_request"
              ]
            },
            "requested_capability": { "type": "string" },
            "normalized_request": { "type": "string" },
            "matched_existing_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action_id", "match_score", "reason"],
                "properties": {
                  "action_id": { "type": "string" },
                  "match_score": { "type": "number", "minimum": 0, "maximum": 1 },
                  "reason": { "type": "string" }
                }
              }
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "capability_name",
            "purpose",
            "target",
            "risk_level",
            "side_effect",
            "requires_approval",
            "inputs",
            "outputs",
            "implementation_hint",
            "test_plan",
            "safety_notes",
            "confidence",
            "approval_required_for_implementation",
            "activation_requires_tests"
          ],
          "properties": {
            "action_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
            "capability_name": { "type": "string" },
            "purpose": { "type": "string" },
            "target": { "type": "string", "enum": ["local", "orangepi5"] },
            "risk_level": { "type": "string", "enum": ["none", "low", "medium", "high", "forbidden"] },
            "side_effect": { "type": "boolean" },
            "requires_approval": { "type": "boolean" },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "fields", "required"],
              "properties": {
                "type": { "type": "string", "enum": ["object"] },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "type", "description"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                },
                "required": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "fields", "required"],
              "properties": {
                "type": { "type": "string", "enum": ["object"] },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "type", "description"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                },
                "required": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "implementation_hint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["executor", "suggested_library", "notes"],
              "properties": {
                "executor": { "type": "string" },
                "suggested_library": { "type": ["string", "null"] },
                "notes": { "type": "string" }
              }
            },
            "test_plan": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type", "assertions"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "assertions": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            },
            "safety_notes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "approval_required_for_implementation": { "type": "boolean" },
            "activation_requires_tests": { "type": "boolean" }
          }
        },
        { "type": "null" }
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_confirmation": { "type": "boolean" },
    "clarifying_question": { "type": ["string", "null"] },
    "safety_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
