{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroKernel LanguageIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "reply",
    "task_spec",
    "dev_task",
    "approval",
    "confidence",
    "requires_confirmation",
    "clarifying_question",
    "safety_notes"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["chat", "question", "task", "dev_task", "approval", "reject", "unknown"]
    },
    "reply": {
      "type": "string"
    },
    "task_spec": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal",
            "target",
            "context",
            "allowed_actions",
            "blocked_actions",
            "success_criteria",
            "risk_level",
            "requires_approval",
            "timeout_seconds",
            "mode",
            "rollback_plan"
          ],
          "properties": {
            "goal": { "type": "string" },
            "target": { "type": "string", "enum": ["local", "orangepi5"] },
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": ["params"],
              "properties": {
                "params": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "limit", "model", "episodes", "service", "lines"],
                  "properties": {
                    "path": { "type": ["string", "null"] },
                    "limit": { "type": ["integer", "null"] },
                    "model": { "type": ["string", "null"] },
                    "episodes": { "type": ["integer", "null"] },
                    "service": { "type": ["string", "null"] },
                    "lines": { "type": ["integer", "null"] }
                  }
                }
              }
            },
            "allowed_actions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "get_uptime",
                  "get_disk_usage",
                  "get_memory_usage",
                  "get_cpu_temp",
                  "get_cpu_per_core_usage",
                  "get_service_status",
                  "tail_logs",
                  "list_artifacts",
                  "get_recent_trace",
                  "run_safe_benchmark",
                  "write_file",
                  "reboot",
                  "delete_file",
                  "read_secret",
                  "git_push"
                ]
              }
            },
            "blocked_actions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "success_criteria": {
              "type": "array",
              "items": { "type": "string" }
            },
            "risk_level": {
              "type": "string",
              "enum": ["none", "low", "medium", "high", "forbidden"]
            },
            "requires_approval": { "type": "boolean" },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
            "mode": { "type": "string", "enum": ["dry_run", "dry_run_or_readonly", "readonly"] },
            "rollback_plan": { "type": ["string", "null"] }
          }
        },
        { "type": "null" }
      ]
    },
    "dev_task": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "summary", "risk_level", "requires_approval"],
          "properties": {
            "goal": { "type": "string" },
            "summary": { "type": "string" },
            "risk_level": { "type": "string", "enum": ["low", "medium", "high", "forbidden"] },
            "requires_approval": { "type": "boolean" }
          }
        },
        { "type": "null" }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id", "decision", "reason"],
          "properties": {
            "task_id": { "type": "string" },
            "decision": { "type": "string", "enum": ["approve", "reject"] },
            "reason": { "type": ["string", "null"] }
          }
        },
        { "type": "null" }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "clarifying_question": {
      "type": ["string", "null"]
    },
    "safety_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
